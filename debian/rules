#!/usr/bin/make -f

export DH_VERBOSE = 1

include /usr/share/dpkg/architecture.mk

# ---------------------------------------------------------------------------
# Go toolchain
#
# The package is built with the Go toolchain bundled in the source package
# (_gotoolchain/<debian-arch>.zip, put there by
# scripts/build-source-package.sh), NOT with the Go of the Ubuntu series.
# Upstream sshpiper tracks the newest Go release; every Ubuntu series is
# frozen on an older one; and Launchpad builders have no network to fetch a
# newer one. Building with the series' Go broke on nearly every upstream
# release. With the toolchain in the source, there is no Go build-dependency
# at all and every series builds the unmodified upstream tree.
# ---------------------------------------------------------------------------
BUILDDIR := $(CURDIR)/_build
BINDIR   := $(BUILDDIR)/bin
GODIR    := $(BUILDDIR)/goroot
GO       := $(GODIR)/bin/go
GO_ZIP   := _gotoolchain/$(DEB_HOST_ARCH).zip

# Don't leak a GOROOT into the go command: it locates its own tree from the
# path of the binary we run.
unexport GOROOT

# `full` build tag includes the optional upstream plugins. Without it, those
# plugins' main.go is gated off by `//go:build full || e2e` and `go build`
# fails with "build constraints exclude all Go files". Harmless on
# cmd/sshpiperd, which doesn't use the tag.
export GOFLAGS := -mod=vendor -trimpath -tags=full
export GO111MODULE := on
# Launchpad builders have no network; vendored deps only, and never try to
# fetch a different toolchain than the bundled one.
export GOPROXY := off
export GOTOOLCHAIN := local

# Launchpad's sbuild sets HOME=/sbuild-nonexistent (a read-only canary
# path) to catch packages that try to write to $HOME during build. Go's
# defaults for GOCACHE / GOTMPDIR / GOMODCACHE are all under $HOME, so
# without overrides `go build` fails with "permission denied" on first
# invocation. Keep everything inside the build tree.
export GOCACHE := $(BUILDDIR)/.gocache
export GOTMPDIR := $(BUILDDIR)/.gotmp
export GOMODCACHE := $(BUILDDIR)/.gomodcache

# Go's official 32-bit ARM toolchain defaults to ARMv6 code. Ubuntu armhf
# is ARMv7 with VFPv3 — target that, as Ubuntu's own Go does.
ifeq ($(DEB_HOST_ARCH),armhf)
export GOARM := 7
endif

# Plugins discovered at build time from plugin/*/main.go.
PLUGINS := $(notdir $(patsubst %/,%,$(dir $(wildcard plugin/*/main.go))))

%:
	dh $@

# Every dh_auto_* step is overridden, so debhelper never has to guess a
# build system for the upstream tree.
override_dh_auto_configure:
	@if [ ! -f "$(GO_ZIP)" ]; then \
		echo 'error: no bundled Go toolchain for $(DEB_HOST_ARCH) ($(GO_ZIP) missing).' >&2; \
		echo '       Add the architecture to debian/control and to go_arch_for() in scripts/build-source-package.sh.' >&2; \
		exit 1; \
	fi
	rm -rf $(GODIR) $(BUILDDIR)/goroot.unpack
	mkdir -p $(BUILDDIR)/goroot.unpack
	unzip -q $(GO_ZIP) -d $(BUILDDIR)/goroot.unpack
	# The zip holds a single tree: golang.org/toolchain@v0.0.1-goX.Y.Z.linux-ARCH/
	mv $(BUILDDIR)/goroot.unpack/golang.org/toolchain@* $(GODIR)
	rm -rf $(BUILDDIR)/goroot.unpack
	# Module zips carry no permission bits; restore the executable bit on
	# the commands, exactly as the go command does when it switches
	# toolchains itself.
	find $(GODIR)/bin $(GODIR)/pkg/tool -type f -exec chmod 0755 {} +
	$(GO) version

override_dh_auto_build:
	@if [ -z "$(PLUGINS)" ]; then \
		echo 'error: no plugin/*/main.go found — upstream layout changed' >&2; \
		exit 1; \
	fi
	mkdir -p $(BINDIR) $(GOCACHE) $(GOTMPDIR) $(GOMODCACHE)
	# Each target is built from inside its own directory so Go resolves
	# whichever module encloses it. cmd/sshpiperd is a nested module since
	# upstream v1.6.1 (`go build ./cmd/sshpiperd` from the root fails with
	# "main module does not contain package"); the plugins currently belong
	# to the root module. build-source-package.sh vendors every module
	# involved.
	cd cmd/sshpiperd && $(GO) build -o $(BINDIR)/sshpiperd .
	set -e; for p in $(PLUGINS); do \
	  (cd plugin/$$p && $(GO) build -o $(BINDIR)/sshpiperd-plugin-$$p .); \
	done

override_dh_auto_install:
	# sshpiperd package
	install -D -m0755 $(BINDIR)/sshpiperd \
	  debian/sshpiperd/usr/sbin/sshpiperd
	install -d debian/sshpiperd/etc/sshpiperd
	install -d debian/sshpiperd/var/lib/sshpiperd
	# sshpiperd-plugins package
	set -e; for p in $(PLUGINS); do \
	  install -D -m0755 $(BINDIR)/sshpiperd-plugin-$$p \
	    debian/sshpiperd-plugins/usr/lib/sshpiperd/plugins/$$p; \
	done

override_dh_auto_test:
	# Skip upstream tests during package build — they need network/fixtures.

override_dh_dwz:
	# Skip DWARF-info deduplication. Go compresses its own debug sections,
	# so dwz refuses to touch them and returns exit 1 on jammy's older
	# dwz (exits 0 on newer versions like in noble/resolute). dh_dwz treats
	# exit 1 as failure and aborts the whole build. Skipping is the canonical
	# Debian Go-packaging workaround — no size savings are lost because
	# dwz wouldn't have done anything anyway.

override_dh_auto_clean:
	# Must work without Go: `dpkg-buildpackage -S` runs this on the CI
	# runner before the toolchain is ever unpacked.
	rm -rf $(BUILDDIR)
