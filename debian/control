Source: sshpiperd
Section: net
Priority: optional
Maintainer: Ryan Lovett <ryan@pixelated.cloud>
# No Go build-dependency on purpose: the package is built with the Go
# toolchain bundled in the source package (see debian/rules). unzip unpacks it.
Build-Depends:
 debhelper-compat (= 13),
 unzip
Standards-Version: 4.6.2
Homepage: https://github.com/tg123/sshpiper
Vcs-Browser: https://github.com/tg123/sshpiper
Vcs-Git: https://github.com/tg123/sshpiper.git
Rules-Requires-Root: no

# Architectures are listed explicitly rather than `any`: each one needs a
# bundled Go toolchain, and scripts/build-source-package.sh reads this list
# to decide which to bundle. Keep both packages' lists identical.
Package: sshpiperd
Architecture: amd64 arm64 armhf
Depends:
 ${shlibs:Depends},
 ${misc:Depends},
 adduser
Recommends: sshpiperd-plugins
Description: SSH reverse proxy / connection router
 sshpiperd routes incoming SSH connections to upstream servers based on
 pluggable logic. Useful for bastion hosts, multi-tenant gateways, and
 per-user routing without shell accounts on the proxy itself.

Package: sshpiperd-plugins
Architecture: amd64 arm64 armhf
Depends:
 ${shlibs:Depends},
 ${misc:Depends},
 sshpiperd (= ${binary:Version})
Description: sshpiperd bundled upstream plugins
 Ships the gRPC-capable upstream plugins (workingdir, yaml, ldap, etc.)
 built from the sshpiper source tree. Install alongside sshpiperd to
 enable plugin-based routing.
